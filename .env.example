# Firebase web app config (Firebase console → Project settings → Your apps).
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_PROJECT_ID=
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Set to "true" to use the local Firebase Emulator Suite (`npm run emulators`).
NUXT_PUBLIC_FIREBASE_USE_EMULATORS=

# Optional. Slack incoming-webhook URL; when set, new bKash payment requests are posted here.
# The site is static (no server), so this URL is baked into the public JS bundle: anyone who
# digs it out can post to that channel. Use a dedicated channel and regenerate the URL if abused.
NUXT_PUBLIC_SLACK_WEBHOOK_URL=

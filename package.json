{
  "name": "broiler-management",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "emulators": "npx firebase-tools emulators:start",
    "deploy:firestore": "npx firebase-tools deploy --only firestore",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "generate:prod": "NUXT_PUBLIC_FIREBASE_USE_EMULATORS=false nuxt generate",
    "deploy": "npm run generate:prod && npx firebase-tools deploy --only hosting,firestore",
    "test:unit": "vitest run tests/unit"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vueuse/core": "^15.0.0",
    "chart.js": "^4.5.1",
    "firebase": "^12.19.0",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@nuxtjs/tailwindcss": "^6.11.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  }
}
